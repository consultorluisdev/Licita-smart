APP_HOST=127.0.0.1
APP_PORT=8082

# openai | ollama
LLM_PROVIDER=ollama
# Padrões: openai=gpt-5.5, ollama=gemma3:4b
# Alternativas locais: llama3.2:3b (mais rápido), qwen3:4b (mais lento, usa reasoning)
LLM_MODEL=gemma3:4b

# Necessário apenas com LLM_PROVIDER=openai
# OPENAI_API_KEY=sua_chave_api

# Ollama (opcional; padrão http://localhost:11434)
OLLAMA_API_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=  # opcional, para daemon remoto/autenticado

RUST_LOG=info
